NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Prepstore
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://pooled-runtime-connection
DATABASE_URL_UNPOOLED=postgresql://direct-migration-connection
AUTH_SECRET=replace-with-at-least-32-random-characters
PASSWORD_PEPPER=replace-with-a-separate-secret
SESSION_TTL_DAYS=30
MAX_ACTIVE_SESSIONS=2
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=3
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=25
LOGIN_WINDOW_MINUTES=15
REGISTER_IP_MAX_ATTEMPTS=5
PASSWORD_RESET_EMAIL_MAX_ATTEMPTS=3
PASSWORD_RESET_IP_MAX_ATTEMPTS=10
MFA_MAX_ATTEMPTS=5
MFA_IP_MAX_ATTEMPTS=20
MFA_ENCRYPTION_KEY=replace-with-a-third-independent-random-secret
MFA_CHALLENGE_TTL_MINUTES=5
ADMIN_SESSION_TTL_HOURS=12
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Prepstore <no-reply@prepstore.in>"
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_LOCAL_ROOT=.local-storage
STORAGE_MAX_FILE_MB=25
MATERIAL_LINK_TTL_SECONDS=300
